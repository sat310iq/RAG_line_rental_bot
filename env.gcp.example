# GCP (Cloud Run) - copy to .env and set in Cloud Run env or Secret Manager
# Webhook service
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4o-mini

# RAG knobs: align with env.example so Cloud Run does not behave stricter than local (was K=5, CSV=0.65).
RAG_VECTOR_STORE_PATH=/app/data/vector_store
RAG_RETRIEVAL_K=16
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TOP_N=3
RAG_SEARCH_TIMEOUT_SEC=3.0
CSV_SCORE_THRESHOLD=0.40
PDF_SCORE_THRESHOLD=0.58

PDF_DOCUMENTS_DIR=/app/data/documents
# Comma-separated TXT basenames under PDF_DOCUMENTS_DIR (must match image contents).
MASTER_TXT_FILES=グランマーレ大分空港契約書.txt,重要事項説明書.txt
KB_CSV_PATH=/app/data/faq_kb.csv
FALLBACK_MESSAGE=該当する情報が見つからないため管理会社にお問い合わせください。

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

GCP_PROJECT_ID=your-project-id
PUBSUB_TOPIC_NAME=rag-line-events

ENV=prod
DEFAULT_CHANNEL=line
PORT=8080

# Worker service only
SLACK_WEBHOOK_URL=

# Optional (future)
# SLACK_BOT_TOKEN=
# SLACK_DEFAULT_CHANNEL=
