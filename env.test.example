# Test environment template
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4o-mini

RAG_VECTOR_STORE_PATH=data/vector_store
# Smaller K for faster tests; production / env.example use 16.
RAG_RETRIEVAL_K=5
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TOP_N=3
RAG_SEARCH_TIMEOUT_SEC=3.0

CSV_SCORE_THRESHOLD=0.40
PDF_SCORE_THRESHOLD=0.60
FALLBACK_MESSAGE=該当する情報が見つからないため管理会社にお問い合わせください。

PDF_DOCUMENTS_DIR=data/documents
FAQ_CSV_PATH=data/dispute_guideline_faq.csv
KB_CSV_PATH=data/faq_kb.csv
TENANT_MASTER_CSV=data/tenants.csv

ENABLE_QUERY_CACHE=true
CACHE_TTL_SEC=3600
