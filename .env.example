# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4o-mini

# Vector Store Configuration
RAG_VECTOR_STORE_PATH=data/vector_store
RAG_RETRIEVAL_K=10
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TOP_N=3
RAG_SEARCH_TIMEOUT_SEC=10.0
CSV_SCORE_THRESHOLD=0.40
PDF_SCORE_THRESHOLD=0.60

# Data Source Paths
PDF_DOCUMENTS_DIR=data/documents
MASTER_TXT_FILES=グランマーレ大分空港契約書.txt
FAQ_CSV_PATH=data/dispute_guideline_faq.csv
KB_CSV_PATH=data/faq_kb.csv
TENANT_MASTER_CSV=data/tenants.csv
FALLBACK_MESSAGE=該当する情報が見つからないため管理会社にお問い合わせください。

# Tenant Authentication (PoC - set at runtime or via CLI)
# TENANT_CONTRACT_ID=your_contract_id
# TENANT_PIN=your_pin

# Operational Settings
FORCE_REINDEX_RENTAL_QA=false
ENABLE_QUERY_CACHE=true
CACHE_TTL_SEC=3600
DEFAULT_CHANNEL=line

# Dev only: POST /debug/rag for container smoke (never enable on public Cloud Run without auth)
ENABLE_DEBUG_RAG_ENDPOINT=false

# LINE / Slack integration
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SLACK_NOTIFY=false
SLACK_WEBHOOK_URL=

# Comet/OPIK Configuration (Optional - for evaluation logging)
COMET_API_KEY=
COMET_PROJECT_NAME=rental-rag-poc
COMET_WORKSPACE=
ENABLE_COMET_LOGGING=false
ENABLE_CHAT_OPIK_LOGGING=true
