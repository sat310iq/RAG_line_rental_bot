# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4o-mini

# Vector Store Configuration
RAG_VECTOR_STORE_PATH=data/vector_store
RAG_RETRIEVAL_K=5
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TOP_N=3
RAG_SEARCH_TIMEOUT_SEC=3.0

# Data Source Paths
PDF_DOCUMENTS_DIR=data/documents
FAQ_CSV_PATH=data/dispute_guideline_faq.csv
KB_CSV_PATH=data/faq_kb.csv
OPS_LOG_CSV_PATH=data/inquiry_history_analyzed.csv
TENANT_MASTER_CSV=data/tenants.csv

# Tenant Authentication (PoC - set at runtime or via CLI)
# TENANT_CONTRACT_ID=your_contract_id
# TENANT_PIN=your_pin

# Operational Settings
FORCE_REINDEX_RENTAL_QA=false
ENABLE_QUERY_CACHE=true
CACHE_TTL_SEC=3600

# Comet/OPIK Configuration (Optional - for evaluation logging)
COMET_API_KEY=
COMET_PROJECT_NAME=rental-rag-poc
COMET_WORKSPACE=
ENABLE_COMET_LOGGING=false
ENABLE_CHAT_OPIK_LOGGING=true
