# Deploy-time env (used by deploy_all.sh, deploy_webhook.sh, deploy_worker.sh, setup_pubsub.sh).
# Copy to .env.gcp and set values: cp deploy/.env.gcp.example deploy/.env.gcp

# Required for deploy
GCP_PROJECT_ID=your-project-id

# Optional (defaults shown)
GCP_REGION=asia-northeast1
PUBSUB_TOPIC_NAME=rag-line-events
PUBSUB_SUBSCRIPTION_NAME=rag-line-events-sub

# Cloud Run runtime env (OPENAI_API_KEY, LINE_CHANNEL_SECRET, LINE_CHANNEL_ACCESS_TOKEN,
# SLACK_WEBHOOK_URL, etc.) are NOT set from this file. Configure them in the Cloud Run
# console or via: gcloud run services update line-webhook --set-env-vars "KEY=VALUE" ...
